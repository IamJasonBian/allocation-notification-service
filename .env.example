# CLI sign-in flow (consumed by netlify/functions/auth-cli + auth-callback)
#
# All four vars below already exist on the production Netlify site.
# Copy them locally for `netlify dev`.

# Google OAuth client (web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google redirects after sign-in. Must be on this site and end at /auth/callback.
# Example (prod): https://allocation-agent.netlify.app/auth/callback
# Example (dev):  http://localhost:8888/auth/callback
OAUTH_REDIRECT_URL=

# Symmetric secret used to sign:
#   - the OAuth `state` token (5 min expiry)
#   - the CLI bearer JWT (30 day expiry, audience="cli")
# Generate with: openssl rand -hex 64
JWT_SECRET=

# Optional allow-list. If unset/empty, any successful Google sign-in is accepted.
# Comma-separated, lowercased on compare.
# AUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
